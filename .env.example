# ==============================================================================
# AASI Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env in production and supply strong, authentic values.
# NEVER commit real production credentials or secrets to version control.

# --- Core Application & Environment ---
AASI_ENV=production
AASI_DEV_MODE=false
AASI_APP_NAME="AASI — Autonomous Aerospace Scientific Intelligence"
AASI_APP_VERSION=1.0.0

# --- Cryptographic Security & Sessions ---
# Generate a cryptographically secure 64-character secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
AASI_SECRET_KEY=change-this-to-a-cryptographically-secure-random-64-char-token
AASI_TOKEN_EXPIRY_HOURS=24

# --- Network & Production CORS ---
# Comma-separated list of allowed frontend domains (NEVER use wildcard '*' in production)
AASI_CORS_ORIGINS=https://aasi.projectpolaris.in,https://projectpolaris.in
CORS_ORIGINS=https://aasi.projectpolaris.in,https://projectpolaris.in
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=https://api.aasi.projectpolaris.in

# --- Storage & Content-Addressed Storage (CAS) ---
AASI_STORAGE_BACKEND=local
AASI_STORAGE_DIR=data/storage
# For S3-compatible remote object storage:
# AASI_STORAGE_BACKEND=s3
# AASI_S3_BUCKET=aasi-cfd-artifacts-prod
# AASI_S3_ENDPOINT=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# --- Resource Quotas & Multitenancy Governance ---
AASI_MAX_CONCURRENT_JOBS_PER_USER=2
AASI_MAX_ARCHIVE_SIZE_MB=100
AASI_MAX_CFD_RUNTIME_SECONDS=1800
AASI_RATE_LIMIT_PER_MINUTE=60
AASI_MAX_RETRIES=3

# --- Epistemic Integrity & Governing Doctrine ---
AASI_FORBID_SYNTHETIC_SUBSTITUTION=true
AASI_STAGE_10_GATE_ENFORCED=true

# --- Logging & Observability ---
LOG_LEVEL=INFO
