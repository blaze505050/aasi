# ─────────────────────────────────────────────────────────────────────────────
# AASI Backend — Production Multi-Stage Docker Build
# Image: python:3.12-slim (Debian Bookworm)
# Security: Non-root user, minimal attack surface, no dev dependencies
# ─────────────────────────────────────────────────────────────────────────────

# Stage 1: Dependency Installation
FROM python:3.12-slim AS deps

WORKDIR /app

# Install only required system packages for compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies (cached unless requirements.txt changes)
COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Stage 2: Production Runtime
FROM python:3.12-slim AS runtime

LABEL maintainer="AASI Engineering <engineering@projectpolaris.in>"
LABEL org.opencontainers.image.title="AASI Backend"
LABEL org.opencontainers.image.description="Autonomous Aerospace Scientific Intelligence — Physics Engine & API"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="Project Polaris"

WORKDIR /app

# Install runtime system dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get purge -y --auto-remove

# Create non-root user for security
RUN groupadd --gid 1001 aasi \
    && useradd --uid 1001 --gid 1001 --shell /bin/bash --create-home aasi

# Copy installed Python packages from deps stage
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

# Copy application code
COPY backend/ /app/backend/
COPY data/ /app/data/

# Create storage directories with proper ownership
RUN mkdir -p /app/data/storage /app/data/exports /app/logs \
    && chown -R aasi:aasi /app

# Environment configuration
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AASI_ENV=production \
    AASI_DEV_MODE=false \
    AASI_STORAGE_DIR=/app/data/storage \
    PORT=8000

# Switch to non-root user
USER aasi

EXPOSE 8000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Use tini as init system for proper signal handling
ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--access-log"]
